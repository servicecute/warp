<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-button background-color="#3465a4" color="#ffffff" />
    </mj-attributes>
    <mj-style>
      .button-link { text-decoration: none; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f5f5f5">
    <mj-section padding="24px">
      <mj-column>
        <mj-image width="120px" src="https://example.com/logo.png" alt="Logo" />
        <mj-text font-size="24px">Hello {{recipient_name}}</mj-text>
        <mj-button href="https://example.com/confirm" css-class="button-link">
          Confirm account
        </mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
